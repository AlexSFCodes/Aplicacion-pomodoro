{
  "name": "pomodoro-app",
  "version": "1.0.0",
  "description": "Aplicación Pomodoro con alarma para mejorar la productividad",
  "main": "main.js",
  "author": "AlexSFCodes",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.alexsfcodes.pomodoro",
    "productName": "Pomodoro Timer",
    "win": {
      "target": "nsis",
      "icon": "logo.ico"
    },
    "nsis": {
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.0.0",
    "@electron-forge/maker-deb": "^7.0.0",
    "@electron-forge/maker-rpm": "^7.0.0",
    "@electron-forge/maker-squirrel": "^7.0.0",
    "@electron-forge/maker-zip": "^7.0.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "electron": "^28.3.3",
    "electron-builder": "^26.8.1"
  }
}
